{
  "project": "coordination",
  "origin": "https://github.com/example/coordination.git",
  "agents": [
    {
      "id": "claude",
      "root": "../coordination-claude",
      "launcher": "start-claude.sh",
      "delivery": "nudge",
      "harnessProcess": "claude"
    },
    {
      "id": "codex",
      "root": "../coordination-codex",
      "launcher": "start-codex.sh",
      "delivery": "pull",
      "harnessProcess": "codex"
    },
    {
      "id": "cursor",
      "root": "../coordination-cursor",
      "launcher": "start-cursor.sh",
      "delivery": "pull"
    },
    {
      "id": "antigravity",
      "root": "../coordination-antigravity",
      "launcher": "start-antigravity.sh",
      "delivery": "pull"
    }
  ],
  "branch": "issue-{issue}/{agent}",
  "baseBranch": "main",
  "maxRevisionRounds": 3,
  "prPolicy": "owner-only",
  "digestPaths": [".plans/issue-{issue}/plan.md"],
  "pollIntervalMs": 1000,
  "verify": {
    "precommit": [{ "name": "fast checks", "argv": ["pnpm", "check:fast"] }],
    "prepush": [{ "name": "end-to-end checks", "argv": ["pnpm", "test:e2e"] }]
  },
  "workflowCriticalPrefixes": ["src/", "test/", "scripts/", "githooks/"],
  "workflowCriticalFiles": ["package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml"],
  "checks": [
    { "name": "install", "argv": ["pnpm", "install", "--frozen-lockfile"] },
    { "name": "check", "argv": ["pnpm", "check"] }
  ]
}
