#!/usr/bin/env bash
# Agent-clone-only hook. Human product clones receive no coordination hooks.
set -euo pipefail
lib="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/identity.sh"
[[ -r "$lib" ]] || { echo "HOOK BLOCKED: cannot read coordination identity runtime at $lib." >&2; exit 1; }
# shellcheck source=lib/identity.sh
. "$lib"

command -v ctags >/dev/null && ctags -R --exclude=.git . 2>/dev/null || true
[[ -x ./directory_tree.sh ]] && ./directory_tree.sh || true
exit 0
