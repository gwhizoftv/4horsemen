#!/usr/bin/env bash
# coord-managed-hook
# Canonical, agent-neutral hook body. See githooks/pre-commit for the placement
# rule; identity is resolved at runtime, never edited into this file.
lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib"
[[ -r "$lib_dir/identity.sh" ]] || { echo "HOOK BLOCKED: cannot read $lib_dir/identity.sh; the coordination install is incomplete." >&2; exit 1; }
# shellcheck source=lib/identity.sh
. "$lib_dir/identity.sh"

# Not an agent clone: pass through to whatever this repository already does.
[[ "$CONSENSUS_AGENT_CLONE" == true ]] || exit 0

command -v ctags >/dev/null && ctags -R --exclude=node_modules --exclude=.git . 2>/dev/null || true
[[ -x ./directory_tree.sh ]] && ./directory_tree.sh || true

# Regenerate the launcher when a merge removed it. The template lives in
# scripts/lib/launcher.sh so that this hook and `coord install` cannot drift
# apart. Never overwrite an existing launcher: a clone may have customised it,
# and this hook runs on every merge.
#
# Exactly one copy of the template is authoritative, decided by how the hooks
# were delivered. With an install root, that install owns it. Without one this
# clone was vendored, so the copy beside these bodies owns it. There is no
# configuration in which both are live, and no fallback between them.
launcher="start-${AGENT_NAME}.sh"
install_root="$(git config --local --get coord.installRoot 2>/dev/null || true)"

if [[ -n "$install_root" ]]; then
  launcher_lib="$install_root/scripts/lib/launcher.sh"
else
  launcher_lib="$lib_dir/launcher.sh"
fi

if [[ ! -e "$launcher" || ! -e ".coord/bin/git" ]] || grep -qF "# coord-managed-git-wrapper" ".coord/bin/git" 2>/dev/null; then
  if [[ ! -r "$launcher_lib" ]]; then
    echo "Cannot regenerate $launcher: the launcher template $launcher_lib is unreadable." >&2
    echo "  Fix: coord doctor --coord-runtime <runtime> --product <product>" >&2
    exit 0
  fi

  # shellcheck source=../scripts/lib/launcher.sh
  . "$launcher_lib"
fi

if [[ ! -e "$launcher" ]]; then
  if write_launcher "$launcher" "$AGENT_NAME" "$AGENT_LABEL" "$SHARED_BRANCH"; then
    echo "Regenerated $launcher (generated per clone, never tracked)."
  else
    echo "No launch command is defined for agent '$AGENT_NAME'; $launcher was not regenerated." >&2
    echo "  Add one to launcher_command() in $launcher_lib." >&2
  fi
fi

# The git shim is refreshed whenever it differs from the template, not only when
# it is missing. It carries the rules that decide which reads are refused during
# an automated issue, so a clone left holding an older copy would keep enforcing
# rules this install has already withdrawn. A file without the managed marker
# was written by someone else and is reported rather than replaced.
wrapper=".coord/bin/git"
if declare -f write_git_wrapper >/dev/null; then
  if [[ -e "$wrapper" ]] && ! grep -qF "# coord-managed-git-wrapper" "$wrapper"; then
    echo "Left $wrapper alone: it is not a coordination-generated file." >&2
  else
    real_git="$(PATH="$(echo "$PATH" | tr ':' '\n' | grep -v '/\.coord/bin$' | paste -sd: -)" command -v git || true)"
    if [[ -z "$real_git" ]]; then
      echo "Cannot regenerate $wrapper: no git found outside .coord/bin." >&2
    else
      staged="$(mktemp -d)/git"
      if write_git_wrapper "$staged" "$real_git" "$(pwd -P)" 2>/dev/null &&
         ! cmp -s "$staged" "$wrapper" 2>/dev/null; then
        mkdir -p "$(dirname "$wrapper")"
        cp "$staged" "$wrapper"
        chmod +x "$wrapper"
        echo "Regenerated $wrapper (generated per clone, never tracked)."
      fi
      rm -rf "$(dirname "$staged")"
    fi
  fi
fi

exit 0
