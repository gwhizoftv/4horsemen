#!/usr/bin/env bash
# coord-managed-hook
# Canonical, agent-neutral hook body. See githooks/pre-commit for the placement
# rule; identity is resolved at runtime, never edited into this file.
lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib"
[[ -r "$lib_dir/identity.sh" ]] || { echo "HOOK BLOCKED: cannot read $lib_dir/identity.sh; the coordination install is incomplete." >&2; exit 1; }
# shellcheck source=lib/identity.sh
. "$lib_dir/identity.sh"

# Not an agent clone: pass through to whatever this repository already does.
[[ "$CONSENSUS_AGENT_CLONE" == true ]] || exit 0

branch=$(git rev-parse --abbrev-ref HEAD)

echo ""
echo "REMINDER ($AGENT_LABEL): committed to '$branch'. Push it so reviewers can see it:"
echo "  git push -u $REMOTE_NAME $branch"

exit 0
