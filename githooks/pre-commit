#!/usr/bin/env bash
# coord-managed-hook
# Canonical, agent-neutral hook body. It lives in the coordination install and
# is reached through a shim in an agent clone's .git/hooks/ — never committed to
# a product's default branch, so a human clone of the same remote is unaffected.
# Identity is resolved at runtime; never edit a clone-specific value into it.
lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib"
[[ -r "$lib_dir/identity.sh" ]] || { echo "HOOK BLOCKED: cannot read $lib_dir/identity.sh; the coordination install is incomplete." >&2; exit 1; }
# shellcheck source=lib/identity.sh
. "$lib_dir/identity.sh"

# Not an agent clone: pass through to whatever this repository already does.
[[ "$CONSENSUS_AGENT_CLONE" == true ]] || exit 0

# shellcheck source=lib/policy.sh
. "$lib_dir/policy.sh"

branch=$(git rev-parse --abbrev-ref HEAD)

# 1) Never commit on the shared branch or consensus branches.
if [[ "$branch" == "$SHARED_BRANCH" ]]; then
  echo "HOOK BLOCKED ($AGENT_LABEL): direct commits to '$SHARED_BRANCH' are forbidden." >&2
  echo "  Create your issue branch first: git checkout -b issue-<n>/$AGENT_NAME" >&2
  exit 1
fi

if [[ "$branch" =~ ^issue-[0-9]+/final$ ]]; then
  echo "HOOK BLOCKED ($AGENT_LABEL): '$branch' is a consensus branch; it is updated only by PR merge." >&2
  exit 1
fi

# 2) Only commit on branches you own: issue-<n>/<agent> or <agent>/<scratch>.
if [[ "$branch" =~ ^issue-[0-9]+/([a-z0-9-]+)$ ]]; then
  owner="${BASH_REMATCH[1]}"
  if [[ "$owner" != "$AGENT_NAME" ]]; then
    echo "HOOK BLOCKED ($AGENT_LABEL): '$branch' belongs to agent '$owner', not you." >&2
    echo "  Review their work with diffs/comments; never commit to their branch." >&2
    exit 1
  fi
elif [[ "$branch" == "$AGENT_NAME"/* ]]; then
  : # personal scratch branch — allowed
else
  echo "HOOK BLOCKED ($AGENT_LABEL): branch '$branch' does not follow the naming scheme." >&2
  echo "  Use issue-<n>/$AGENT_NAME for issue work, or $AGENT_NAME/<name> for scratch work." >&2
  exit 1
fi

# 3) Shared policy inspects the actual staged index with NUL-safe paths. Only
# coordination evidence and explicitly allowlisted documentation narrow checks.
coord_verify precommit || exit 1

exit 0
