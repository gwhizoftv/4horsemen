{
  "project": "coordination",
  "origin": "https://github.com/example/coordination.git",
  "agents": [
    {
      "id": "claude",
      "root": "../coordination-claude",
      "launcher": "start-claude.sh",
      "delivery": "nudge",
      "harnessProcess": "claude",
      "nudgePrelude": [],
      "nudgeSubmit": ["Enter"],
      "terminalProfile": "Pro"
    },
    {
      "id": "codex",
      "root": "../coordination-codex",
      "launcher": "start-codex.sh",
      "delivery": "pull",
      "harnessProcess": "codex",
      "nudgePrelude": ["i"],
      "nudgeSubmit": ["C-j"],
      "terminalProfile": "Grass"
    },
    {
      "id": "cursor",
      "root": "../coordination-cursor",
      "launcher": "start-cursor.sh",
      "delivery": "pull",
      "nudgePrelude": [],
      "nudgeSubmit": ["Enter"],
      "terminalProfile": "Ocean"
    },
    {
      "id": "antigravity",
      "root": "../coordination-antigravity",
      "launcher": "start-antigravity.sh",
      "delivery": "pull",
      "nudgePrelude": [],
      "nudgeSubmit": ["Enter"],
      "terminalProfile": "Red Sands"
    }
  ],
  "branch": "issue-{issue}/{agent}",
  "baseBranch": "main",
  "profile": "consensus",
  "maxRevisionRounds": 3,
  "prPolicy": "owner-only",
  "digestPaths": [],
  "pollIntervalMs": 1000,
  "checks": [
    { "name": "install", "argv": ["pnpm", "install", "--frozen-lockfile"] },
    { "name": "check", "argv": ["pnpm", "check"] }
  ]
}
