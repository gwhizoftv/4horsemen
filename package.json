{
  "name": "@coord/coordination",
  "version": "0.0.15",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": { "node": ">=26.0.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "lint": "eslint src test",
    "test": "pnpm test:fast && pnpm test:e2e",
    "test:fast": "vitest run --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check:version-bump": "pnpm build && node dist/checkVersionBump.js",
    "check:fast": "pnpm lint && pnpm typecheck && pnpm test:fast",
    "check": "pnpm build && pnpm check:fast && pnpm test:e2e"
  },
  "dependencies": { "zod": "^4.4.3" },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
