#!/usr/bin/env bash
set -euo pipefail
# Resolve symlinks (e.g. ~/.local/bin/coord → install-root/coord) without
# changing the caller's cwd — relative CLI paths must resolve from there.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  TARGET="$(readlink "$SOURCE")"
  if [[ "$TARGET" == /* ]]; then
    SOURCE="$TARGET"
  else
    SOURCE="$DIR/$TARGET"
  fi
done
ROOT="$(cd -P "$(dirname "$SOURCE")" && pwd)"
RUNTIME="$ROOT/scripts/lib/node-runtime.sh"
if [[ ! -x "$RUNTIME" ]]; then
  echo "coord: missing executable Node selector at $RUNTIME; repair the install (re-run bootstrap or restore scripts/lib/node-runtime.sh)." >&2
  exit 1
fi
NODE_BIN="$("$RUNTIME" --print-path)" || exit 1
if [[ ! -f "$ROOT/dist/main.js" ]] || find "$ROOT/src" -type f -newer "$ROOT/dist/main.js" -print -quit | grep -q .; then
  (cd "$ROOT" && PATH="$(dirname "$NODE_BIN"):$PATH" pnpm build) >&2
fi
# Exec the selected Node with the original PATH so product children keep the
# workspace development runtime.
exec "$NODE_BIN" "$ROOT/dist/main.js" "$@"
