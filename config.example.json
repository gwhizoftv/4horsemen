{
  "project": "coordination",
  "agents": [
    { "id": "claude", "root": "../coordination-claude" },
    { "id": "codex", "root": "../coordination-codex" },
    { "id": "cursor", "root": "../coordination-cursor" },
    { "id": "antigravity", "root": "../coordination-antigravity" }
  ],
  "branchTemplate": "issue-{issue}/{agent}",
  "maxRevisionRounds": 3,
  "prPolicy": "unmerged",
  "finalization": {
    "checkArgv": ["pnpm", "install", "--frozen-lockfile", "&&", "pnpm", "check"]
  }
}
