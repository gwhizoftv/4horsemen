{
  "project": "coordination",
  "origin": "https://github.com/example/coordination.git",
  "agents": [
    {
      "id": "claude",
      "root": "../coordination-claude",
      "launcher": "start-claude.sh",
      "delivery": "nudge",
      "harnessProcess": "claude",
      "nudgePrelude": [],
      "nudgeSubmit": ["Escape", "Enter"],
      "terminalProfile": "Pro"
    },
    {
      "id": "codex",
      "root": "../coordination-codex",
      "launcher": "start-codex.sh",
      "delivery": "pull",
      "harnessProcess": "codex",
      "nudgePrelude": ["i"],
      "nudgeSubmit": ["C-j", "C-m"],
      "terminalProfile": "Grass"
    },
    {
      "id": "cursor",
      "root": "../coordination-cursor",
      "launcher": "start-cursor.sh",
      "delivery": "pull",
      "nudgePrelude": [],
      "nudgeSubmit": ["Enter"],
      "terminalProfile": "Ocean"
    },
    {
      "id": "antigravity",
      "root": "../coordination-antigravity",
      "launcher": "start-antigravity.sh",
      "delivery": "pull",
      "nudgePrelude": [],
      "nudgeSubmit": ["Enter"],
      "terminalProfile": "Red Sands"
    }
  ],
  "branch": "issue-{issue}/{agent}",
  "baseBranch": "main",
  "completesRoot": "/absolute/path/to/completes/coord-runtime",
  "profile": "consensus",
  "maxRevisionRounds": 3,
  "prPolicy": "coord-open-unmerged",
  "digestPaths": [],
  "contextPaths": ["docs/repo-map.md"],
  "pollIntervalMs": 1000,
  "verify": {
    "precommit": [{ "name": "check:fast", "argv": ["pnpm", "check:fast"] }],
    "prepush": [
      { "name": "test:system", "argv": ["pnpm", "test:system"] },
      { "name": "test:e2e", "argv": ["pnpm", "test:e2e"] }
    ]
  },
  "verification": {
    "mode": "coordinator",
    "coordinated": {
      "precommit": [{ "name": "check:fast", "argv": ["pnpm", "check:fast"] }],
      "prepush": []
    },
    "candidate": {
      "checks": [
        { "name": "install", "argv": ["pnpm", "install", "--frozen-lockfile"] },
        { "name": "lint", "argv": ["pnpm", "lint"],
          "cache": { "inputs": "tree-excluding-evidence", "probes": [["node", "--version"], ["pnpm", "--version"]] } },
        { "name": "typecheck", "argv": ["pnpm", "typecheck"],
          "cache": { "inputs": "tree-excluding-evidence", "probes": [["node", "--version"], ["pnpm", "--version"]] } },
        { "name": "test:fast", "argv": ["pnpm", "test:fast"],
          "cache": { "inputs": "tree-excluding-evidence", "probes": [["node", "--version"], ["pnpm", "--version"]] } },
        { "name": "test:system", "argv": ["pnpm", "test:system"], "expensive": true,
          "cache": { "inputs": "tree-excluding-evidence", "probes": [["node", "--version"], ["pnpm", "--version"]] } }
      ],
      "covers": { "prefixes": ["src/", "test/", "docs/"], "files": ["AGENTS.md", "config.example.json", "config.product.example.json"] },
      "rules": [
        { "prefixes": ["githooks/", "templates/", "scripts/"], "add": ["test:e2e"] },
        {
          "files": ["package.json", "pnpm-lock.yaml", "tsconfig.json", "test/tsconfig.json", "eslint.config.js",
            "vitest.config.ts", "vitest.system.config.ts", "vitest.e2e.config.ts"],
          "add": "all"
        }
      ]
    },
    "maxConcurrentExpensive": 1
  },
  "documentation": {
    "paths": ["README.md", "CONTRIBUTING.md", "SECURITY.md", "docs/setup-workspace.md", "docs/analytics.md"],
    "verify": {
      "precommit": [{ "name": "check:docs", "argv": ["pnpm", "check:docs"] }],
      "prepush": [{ "name": "check:docs", "argv": ["pnpm", "check:docs"] }]
    },
    "checks": [
      { "name": "install", "argv": ["pnpm", "install", "--frozen-lockfile"] },
      { "name": "check:docs", "argv": ["pnpm", "check:docs"] }
    ]
  },
  "checks": [
    { "name": "install", "argv": ["pnpm", "install", "--frozen-lockfile"] },
    { "name": "lint", "argv": ["pnpm", "lint"],
      "cache": { "inputs": "tree-excluding-evidence", "probes": [["node", "--version"], ["pnpm", "--version"]] } },
    { "name": "typecheck", "argv": ["pnpm", "typecheck"],
      "cache": { "inputs": "tree-excluding-evidence", "probes": [["node", "--version"], ["pnpm", "--version"]] } },
    { "name": "test:fast", "argv": ["pnpm", "test:fast"],
      "cache": { "inputs": "tree-excluding-evidence", "probes": [["node", "--version"], ["pnpm", "--version"]] } },
    { "name": "test:system", "argv": ["pnpm", "test:system"], "expensive": true,
      "cache": { "inputs": "tree-excluding-evidence", "probes": [["node", "--version"], ["pnpm", "--version"]] } },
    { "name": "build", "argv": ["pnpm", "build"] },
    { "name": "test:e2e", "argv": ["pnpm", "test:e2e"], "expensive": true,
      "cache": { "inputs": "tree-excluding-evidence", "probes": [["node", "--version"], ["pnpm", "--version"]] } }
  ]
}
