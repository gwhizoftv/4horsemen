#!/usr/bin/env bash
# Tracked, agent-neutral hook. Identity is resolved at runtime.
lib="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/identity.sh"
[[ -r "$lib" ]] || { echo "HOOK BLOCKED: cannot read $lib" >&2; exit 1; }
. "$lib"

branch=$(git rev-parse --abbrev-ref HEAD)

if [[ "$branch" == "$SHARED_BRANCH" ]]; then
  echo "HOOK BLOCKED ($AGENT_LABEL): direct commits to '$SHARED_BRANCH' are forbidden." >&2
  exit 1
fi

if [[ "$branch" =~ ^issue-[0-9]+/final$ ]]; then
  echo "HOOK BLOCKED ($AGENT_LABEL): '$branch' is a consensus branch; it is updated only by PR merge." >&2
  exit 1
fi

if [[ "$branch" =~ ^issue-[0-9]+/([a-z0-9-]+)$ ]]; then
  owner="${BASH_REMATCH[1]}"
  if [[ "$owner" != "$AGENT_NAME" ]]; then
    echo "HOOK BLOCKED ($AGENT_LABEL): '$branch' belongs to agent '$owner', not you." >&2
    exit 1
  fi
elif [[ "$branch" == "$AGENT_NAME"/* ]]; then
  : # allowed
else
  echo "HOOK BLOCKED ($AGENT_LABEL): branch '$branch' does not follow the naming scheme." >&2
  exit 1
fi

# Determine if we need to run checks
install_root="$(git config --get coord.installRoot 2>/dev/null || true)"
staged="$(git diff --cached --name-only 2>/dev/null)"
run_checks=false

if [[ -n "$staged" ]]; then
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    if [[ ! "$path" =~ ^\.(signals|plans|code-reviews|amendments|escalations)/ ]]; then
      run_checks=true
      break
    fi
  done <<< "$staged"
else
  run_checks=true
fi

if [[ "$run_checks" == false ]]; then
  echo "$AGENT_LABEL hook: skipping checks for coordination-only commit."
  exit 0
fi

if [[ -n "$install_root" && -f "$install_root/workspace.json" ]]; then
  # Extract verify commands from workspace.json
  # Simple python script to parse and execute them
  python3 -c '
import sys, json, subprocess
try:
    with open(sys.argv[1]) as f:
        config = json.load(f)
    verify = config.get("verify")
    if verify is None:
        print("HOOK BLOCKED: verify array is missing in workspace config. Add it or set to [] to explicitly allow.", file=sys.stderr)
        sys.exit(1)
    if not verify:
        sys.exit(0)
    for check in verify:
        print(f"Running {check[\"name\"]}...")
        result = subprocess.run(check["argv"])
        if result.returncode != 0:
            print(f"HOOK BLOCKED: {check[\"name\"]} failed — fix before committing.", file=sys.stderr)
            sys.exit(1)
except Exception as e:
    print(f"Error parsing workspace config: {e}", file=sys.stderr)
    sys.exit(1)
' "$install_root/workspace.json" || exit 1
fi

exit 0
